@layout()
  <div class="hero">
    <h1>Precision document & multi-rate pricing engine</h1>
    <p>
      Create accurate invoices, quotes, and bills with line-item discounts, custom tax rates, and zero rounding errors.
    </p>
  </div>

  <div class="cards">
    <div class="card">
      <h3>Exact Math Engine &nbsp;›</h3>
      <p>
        Integer-based pricing engine powered by integer cents eliminates floating-point rounding bugs.
      </p>
    </div>
    <div class="card">
      <h3>Multi-Rate Discounts & Tax &nbsp;›</h3>
      <p>
        Apply fixed amounts or percentage discounts per line item with precise subtotal breakdowns.
      </p>
    </div>
    <div class="card">
      <h3>Immutable Finalization &nbsp;›</h3>
      <p>Lock finalized documents against accidental edits while keeping full audit history.</p>
    </div>
  </div>
@end
