<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Summary Report - Pricing Calculator</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
        line-height: 1.5;
      }
      .filter-card {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        padding: 1.25rem;
        border-radius: 6px;
        margin-bottom: 2rem;
      }
      .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)) auto;
        gap: 12px;
        align-items: end;
      }
      label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 4px;
      }
      input,
      select {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-sizing: border-box;
      }
      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }
      .metric-card {
        background: #f3f4f6;
        padding: 1rem;
        border-radius: 6px;
        border-left: 4px solid #2563eb;
      }
      .metric-card .value {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1e3a8a;
      }
      button {
        background: #2563eb;
        color: white;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-reset {
        background: #6b7280;
        text-decoration: none;
        color: white;
        padding: 8px 14px;
        border-radius: 4px;
        font-size: 0.9rem;
        display: inline-block;
      }
      .btn-back {
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
      }
      .btn-back:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    {{-- 1. DEFINE ACTIVE ERROR FOR BOTH DIRECT RENDER AND FLASH STORE --}}
    @assign(activeError = errorMessage || flashMessages.get('error'))
    {{-- FLASH / ERROR MESSAGE BANNER --}}
    @if(activeError)
      <div
        style="background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px; border-radius: 6px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;"
      >
        <span>{{ activeError }}</span>
        <a
          href="{{ route('documents.summary_report') }}"
          style="color: #991b1b; font-weight: bold; font-size: 0.85rem; text-decoration: underline;"
        >
          Clear Filters
        </a>
      </div>
    @end

    <div
      style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;"
    >
      <h1 style="margin: 0;">Document Summary Report</h1>
      <a href="{{ route('documents.index') }}" class="btn-back">← Back to Documents</a>
    </div>
    {{-- Filter Form --}}
    <div class="filter-card">
      <form action="{{ route('documents.summary_report') }}" method="GET">
        <div class="filter-grid">
          <div>
            <label for="startDate">From Date</label>
            <input
              type="date"
              id="startDate"
              name="startDate"
              value="{{ filters.startDate || '' }}"
            />
          </div>

          <div>
            <label for="endDate">To Date</label>
            {{-- 2. USE activeError HERE SO THE INPUT TURNS RED ON FIRST CLICK --}}
            <input
              type="date"
              id="endDate"
              name="endDate"
              value="{{ filters.endDate || '' }}"
              style="{{
                activeError
                  ? 'border-color: #ef4444; background-color: #fef2f2;'
                  : ''
              }}"
            />
          </div>

          <div style="display: flex; gap: 8px;">
            <button type="submit">Filter</button>
            <a href="{{ route('documents.summary_report') }}" class="btn-reset">Reset</a>
          </div>
        </div>
      </form>
    </div>
    {{-- Aggregated Metrics Cards --}}
    <div class="metrics-grid">
      <div class="metric-card">
        <div>Total Finalized Documents</div>
        <div class="value">{{ report.totalDocuments || 0 }}</div>
      </div>
      <div class="metric-card">
        <div>Total Revenue</div>
        <div class="value">${{ Number(report.aggregateGrandTotal || 0).toFixed(2) }}</div>
      </div>
      <div class="metric-card">
        <div>Total Discounts</div>
        <div class="value">
          -${{ Number(report.aggregateTotalDiscount || 0).toFixed(2) }}
        </div>
      </div>
      <div class="metric-card">
        <div>Total Tax Collected</div>
        <div class="value">${{ Number(report.aggregateTotalTax || 0).toFixed(2) }}</div>
      </div>
    </div>
  </body>
</html>
