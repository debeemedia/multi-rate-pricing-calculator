@layout()
  <div class="report-container">
    {{-- Header & Navigation --}}
    <div class="report-header-row mb-4">
      <div>
        <a href="{{ route('documents.index') }}" class="back-link">← Back to Documents List</a>

        <h1 class="page-title mt-4">Document Summary Report</h1>
      </div>
    </div>
    {{-- Error Banner --}}
    @assign(activeError = errorMessage || flashMessages.get('error'))
    @if(activeError)
      <div class="alert alert-destructive mb-4">
        <span>{{ activeError }}</span>
        <a href="{{ route('documents.summary_report') }}" class="alert-action-link">
          Clear Filters
        </a>
      </div>
    @end
    {{-- Filter Form Block --}}
    <div class="card-block mb-4">
      <form action="{{ route('documents.summary_report') }}" method="GET">
        <div class="report-filter-grid">
          <div class="form-field">
            <label for="startDate">Issue Date From</label>

            <input
              type="date"
              id="startDate"
              name="startDate"
              value="{{ filters.startDate || '' }}"
            />
          </div>

          <div class="form-field">
            <label for="endDate">Issue Date To</label>

            <input
              type="date"
              id="endDate"
              name="endDate"
              value="{{ filters.endDate || '' }}"
              class="{{ activeError ? 'input-error' : '' }}"
            />
          </div>

          <div class="form-field">
            <label for="currencyCode">Currency</label>
            <select id="currencyCode" name="currencyCode" class="form-select">
              @each(currency in supportedCurrencies)
                <option
                  value="{{ currency.code }}"
                  {{
                    filters.currencyCode === currency.code ||
                    (!filters.currencyCode && defaultCurrencyCode === currency.code)
                      ? 'selected'
                      : ''
                  }}
                >
                  {{ currency.code }}
                  ({{ currency.symbol }}) —
                  {{ currency.name }}
                </option>
              @end
            </select>
          </div>

          <div class="filter-actions">
            <button type="submit" class="button">Apply Filter</button>
            <a href="{{ route('documents.summary_report') }}" class="button secondary">Reset</a>
          </div>
        </div>
      </form>
    </div>
    {{-- Active Date Scope Pill --}}
    <div class="report-context-bar">
      <span class="context-pill">
        Showing metrics for
        <strong>finalized {{ filters.currencyCode }}</strong>
         documents

        @if(filters.startDate && filters.endDate)
          with
          <strong>issue date</strong>
          between
          <strong>{{ filters.startDate }} and {{ filters.endDate }}</strong>
        @elseif(filters.startDate)
          with
          <strong>issue date</strong>
          from
          <strong>{{ filters.startDate }} onwards</strong>
        @elseif(filters.endDate)
          with
          <strong>issue date</strong>
          up to
          <strong>{{ filters.endDate }}</strong>
        @else
          for
          <strong>All-Time (Default)</strong>
        @end
      </span>
    </div>
    {{-- Aggregated Metrics Cards --}}
    <div class="metrics-grid">
      <div class="metric-card">
        <span class="metric-label">Total Finalized Documents</span>
        <span class="metric-value font-mono">{{ report.totalDocuments || 0 }}</span>
      </div>

      <div class="metric-card">
        <span class="metric-label">Total Discounts</span>
        <span class="metric-value font-mono">
          -{{ filters.currencySymbol }}{{ Number(report.aggregateTotalDiscount || 0).toFixed(2) }}
        </span>
      </div>

      <div class="metric-card">
        <span class="metric-label">Total Tax</span>
        <span class="metric-value font-mono">
          {{ filters.currencySymbol }}{{ Number(report.aggregateTotalTax || 0).toFixed(2) }}
        </span>
      </div>

      <div class="metric-card highlight">
        <span class="metric-label">Sum of Grand Totals</span>
        <span class="metric-value font-mono">
          {{ filters.currencySymbol }}{{ Number(report.aggregateGrandTotal || 0).toFixed(2) }}
        </span>
      </div>
    </div>
  </div>
@end
