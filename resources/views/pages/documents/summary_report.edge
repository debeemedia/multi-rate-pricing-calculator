@layout()
  <div class="report-container">
    {{-- Header & Navigation --}}
    <div class="report-header-row mb-4">
      <div>
        <a href="{{ route('documents.index') }}" class="back-link">← Back to Documents List</a>
        <h1 class="page-title mt-2">Document Summary Report</h1>
      </div>
    </div>
    {{-- Error Banner --}}
    @assign(activeError = errorMessage || flashMessages.get('error'))
    @if(activeError)
      <div class="alert alert-destructive mb-4">
        <span>{{ activeError }}</span>
        <a href="{{ route('documents.summary_report') }}" class="alert-action-link">
          Clear Filters
        </a>
      </div>
    @end
    {{-- Filter Form Block --}}
    <div class="card-block mb-4">
      <form action="{{ route('documents.summary_report') }}" method="GET">
        <div class="report-filter-grid">
          <div class="form-field">
            <label for="startDate">From Date</label>
            <input
              type="date"
              id="startDate"
              name="startDate"
              value="{{ filters.startDate || '' }}"
            />
          </div>

          <div class="form-field">
            <label for="endDate">To Date</label>
            <input
              type="date"
              id="endDate"
              name="endDate"
              value="{{ filters.endDate || '' }}"
              class="{{ activeError ? 'input-error' : '' }}"
            />
          </div>

          <div class="filter-actions">
            <button type="submit" class="button">Apply Filter</button>
            <a href="{{ route('documents.summary_report') }}" class="button secondary">Reset</a>
          </div>
        </div>
      </form>
    </div>
    {{-- Active Date Scope Context Note --}}
    <div class="report-context-bar mb-3">
      <span class="context-pill">
        Showing metrics for:
        <strong>
          @if(filters.startDate && filters.endDate)
            {{ filters.startDate }}
            to
            {{ filters.endDate }}
          @elseif(filters.startDate)
            From
            {{ filters.startDate }}
            onwards
          @elseif(filters.endDate)
            Up to
            {{ filters.endDate }}
          @else
            All-Time / Default Range
          @end
        </strong>
      </span>
    </div>
    {{-- Aggregated Metrics Cards --}}
    <div class="metrics-grid">
      <div class="metric-card">
        <span class="metric-label">Total Finalized Documents</span>
        <span class="metric-value font-mono">{{ report.totalDocuments || 0 }}</span>
      </div>

      <div class="metric-card highlight">
        <span class="metric-label">Total Revenue</span>
        <span class="metric-value font-mono">
          ${{ Number(report.aggregateGrandTotal || 0).toFixed(2) }}
        </span>
      </div>

      <div class="metric-card">
        <span class="metric-label">Total Discounts</span>
        <span class="metric-value font-mono">
          -${{ Number(report.aggregateTotalDiscount || 0).toFixed(2) }}
        </span>
      </div>

      <div class="metric-card">
        <span class="metric-label">Total Tax Collected</span>
        <span class="metric-value font-mono">
          ${{ Number(report.aggregateTotalTax || 0).toFixed(2) }}
        </span>
      </div>
    </div>
  </div>
@end
