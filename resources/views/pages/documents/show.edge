@layout({ suppressFlash: false })
  <div class="document-detail-container">
    {{-- Breadcrumb Navigation --}}
    <div class="mb-4">
      <a href="{{ route('documents.index') }}" class="back-link">← Back to Documents List</a>
    </div>
    {{-- Document Header --}}
    <div class="document-header-card">
      <div class="header-main">
        <div>
          <div class="header-title-row">
            <h1>{{ document.title }}</h1>
            <span
              class="badge {{ document.status === 'finalized' ? 'badge-success' : 'badge-draft' }}"
            >
              {{ document.status }}
            </span>
          </div>
          <p class="subtitle">
            Customer:
            <strong>{{ document.customerName }}</strong>
            <span class="divider">•</span>
            Issue Date:
            <strong>{{ document.issueDate.toISODate() }}</strong>
          </p>
        </div>
      </div>
      {{-- Editable Details Accordion for Drafts --}}
      @if(document.status === 'draft')
        <details class="edit-details-toggle">
          <summary>Edit Basic Details</summary>
          <form
            action="{{ route('documents.update', { id: document.id }) }}?_method=PUT"
            method="POST"
            class="edit-details-form"
          >
            {{ csrfField() }}
            <div class="inline-field">
              <label for="edit-title">Title</label>
              <input
                type="text"
                id="edit-title"
                name="title"
                value="{{ old('title') || document.title }}"
                placeholder="Title"
                required
              />
            </div>
            <div class="inline-field">
              <label for="edit-customer">Customer</label>
              <input
                type="text"
                id="edit-customer"
                name="customerName"
                value="{{ old('customerName') || document.customerName }}"
                placeholder="Customer Name"
                required
              />
            </div>
            <div class="inline-field">
              <label for="edit-date">Issue Date</label>
              <input
                type="date"
                id="edit-date"
                name="issueDate"
                value="{{ old('issueDate') || document.issueDate.toISODate() }}"
                required
              />
            </div>
            <button type="submit" class="button secondary">Save Details</button>
          </form>
        </details>
      @end
    </div>
    {{-- Line Items Table --}}
    <div class="section-block">
      <h2>Line Items</h2>
      @if(document.documentLineItems.length === 0)
        <div class="empty-state">
          <p>No line items added yet.</p>
        </div>
      @else
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Description</th>
                <th class="text-center">Qty</th>
                <th class="text-right">Unit Price</th>
                <th class="text-right">Discount</th>
                <th class="text-right">Tax %</th>
                <th class="text-right">Subtotal</th>
                <th class="text-right">Line Total</th>
                @if(document.status === 'draft')
                  <th class="text-center">Action</th>
                @end
              </tr>
            </thead>
            <tbody>
              @each(item in document.documentLineItems)
                <tr>
                  <td class="font-medium">{{ item.description }}</td>
                  <td class="text-center font-mono">{{ item.quantity }}</td>
                  <td class="text-right font-mono">${{ Number(item.unitPrice).toFixed(2) }}</td>
                  <td class="text-right font-mono">
                    @if(item.discountType === 'percent')
                      {{ item.discountValue }}
                      %
                    @elseif(item.discountType === 'fixed')
                      $
                      {{ Number(item.discountValue).toFixed(2) }}
                    @else
                      None
                    @end
                  </td>
                  <td class="text-right font-mono">{{ item.taxPercent }}%</td>
                  <td class="text-right font-mono">${{ Number(item.subtotal).toFixed(2) }}</td>
                  <td class="text-right font-mono font-medium">
                    ${{ Number(item.lineTotal).toFixed(2) }}
                  </td>
                  @if(document.status === 'draft')
                    <td class="text-center">
                      <form
                        action="{{
                          route('documents.document_line_items.destroy', {
                            document_id: document.id,
                            id: item.id,
                          })
                        }}?_method=DELETE"
                        method="POST"
                        onsubmit="return confirm('Remove this line item?');"
                      >
                        {{ csrfField() }}
                        <button type="submit" class="btn-delete-item">Delete</button>
                      </form>
                    </td>
                  @end
                </tr>
              @end
            </tbody>
          </table>
        </div>
        {{-- Totals Summary Box --}}
        <div class="totals-summary-container">
          <div class="totals-box">
            <div class="totals-row">
              <span>Subtotal</span>
              <span class="font-mono">${{ Number(document.subtotal).toFixed(2) }}</span>
            </div>
            <div class="totals-row">
              <span>Total Discount</span>
              <span class="font-mono">-${{ Number(document.totalDiscount).toFixed(2) }}</span>
            </div>
            <div class="totals-row">
              <span>Total Tax</span>
              <span class="font-mono">+${{ Number(document.totalTax).toFixed(2) }}</span>
            </div>
            <div class="totals-row grand">
              <span>Grand Total</span>
              <span class="font-mono">${{ Number(document.grandTotal).toFixed(2) }}</span>
            </div>
          </div>
        </div>
      @end
    </div>
    {{-- Add Line Item Form (Draft Only) --}}
    @if(document.status === 'draft')
      <div class="card-form-block">
        <h3>Add Line Item</h3>
        <form
          action="{{
            route('documents.document_line_items.store', {
              document_id: document.id,
            })
          }}"
          method="POST"
        >
          {{ csrfField() }}
          <div class="line-item-grid">
            <div class="grid-field span-2">
              <label for="item-description">Description</label>
              <input
                type="text"
                id="item-description"
                name="description"
                placeholder="e.g. Web Development"
                value="{{ old('description') || '' }}"
                required
              />
            </div>

            <div class="grid-field">
              <label for="item-qty">Qty</label>
              <input
                type="number"
                id="item-qty"
                name="quantity"
                placeholder="1"
                min="1"
                value="{{ old('quantity') || '1' }}"
                required
              />
            </div>

            <div class="grid-field">
              <label for="item-unit-price">Unit Price ($)</label>
              <input
                type="number"
                id="item-unit-price"
                step="0.01"
                name="unitPrice"
                placeholder="0.00"
                value="{{ old('unitPrice') || '' }}"
                required
              />
            </div>

            <div class="grid-field">
              <label for="item-discount-type">Discount Type</label>
              <select id="item-discount-type" name="discountType">
                <option value="none" {{ old('discountType') === 'none' ? 'selected' : '' }}>
                  No Discount
                </option>
                <option value="fixed" {{ old('discountType') === 'fixed' ? 'selected' : '' }}>
                  Fixed ($)
                </option>
                <option value="percent" {{ old('discountType') === 'percent' ? 'selected' : '' }}>
                  Percent (%)
                </option>
              </select>
            </div>

            <div class="grid-field">
              <label for="item-discount-val">Discount Val</label>
              <input
                type="number"
                id="item-discount-val"
                step="0.01"
                name="discountValue"
                placeholder="0.00"
                value="{{ old('discountValue') || '0' }}"
              />
            </div>

            <div class="grid-field">
              <label for="item-tax-percent">Tax %</label>
              <input
                type="number"
                id="item-tax-percent"
                step="0.01"
                name="taxPercent"
                placeholder="0.00"
                value="{{ old('taxPercent') || '0' }}"
              />
            </div>
          </div>

          <div class="mt-4"><button type="submit" class="button">+ Add Line Item</button></div>
        </form>
      </div>
      {{-- Action Bar --}}
      <div class="document-actions-bar">
        @if(document.documentLineItems.length)
          <form
            action="{{ route('documents.finalize', { id: document.id }) }}?_method=PATCH"
            method="POST"
            onsubmit="return confirm('Are you sure you want to finalize this document? Once finalized, line items and pricing can no longer be modified.');"
          >
            {{ csrfField() }}
            <button type="submit" class="button success">Finalize Document (Freeze)</button>
          </form>
        @else
          <div class="disabled-action-group">
            <button type="button" class="button secondary" disabled>Finalize Document</button>
            <span class="tip-text">Add at least one line item to finalize.</span>
          </div>
        @end

        <form
          action="{{ route('documents.destroy', { id: document.id }) }}?_method=DELETE"
          method="POST"
          class="ml-auto"
        >
          {{ csrfField() }}
          <button
            type="submit"
            class="button destructive"
            onclick="return confirm('Delete this draft?')"
          >
            Delete Draft
          </button>
        </form>
      </div>
    @else
      <div class="read-only-banner">
        <p>✔ This document is finalized and read-only. No further modifications can be made.</p>
      </div>
    @end
  </div>
@end
