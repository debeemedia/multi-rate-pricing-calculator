<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Document - Pricing Calculator</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        max-width: 600px;
        margin: 40px auto;
        padding: 0 20px;
        line-height: 1.5;
      }
      .form-group {
        margin-bottom: 1.2rem;
      }
      label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.4rem;
      }
      input[type='text'],
      input[type='date'] {
        width: 100%;
        padding: 8px 12px;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 4px;
      }
      button {
        background: #2563eb;
        color: white;
        padding: 10px 16px;
        border: none;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover {
        background: #1d4ed8;
      }
      .error {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
      }
      .flash-error {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #991b1b;
        padding: 12px;
        border-radius: 4px;
        margin-bottom: 1rem;
      }
    </style>
  </head>
  <body>
    <h1>Create New Document</h1>
    {{-- Domain / Exception errors --}}
    @if(flashMessages.has('error'))
      <div class="flash-error">{{ flashMessages.get('error') }}</div>
    @end
    {{-- Validdation errors --}}
    @if(flashMessages.has('inputErrorsBag'))
      <div class="flash-error">
        <ul>
          @each((messages, field) in flashMessages.get('inputErrorsBag'))
            @each(message in messages)
              <li>{{ field }}: {{ message }}</li>
            @end
          @end
        </ul>
      </div>
    @end

    <form action="{{ route('documents.store') }}" method="POST">
      {{ csrfField() }}
      <div class="form-group">
        <label for="title">Document Title</label>
        <input
          type="text"
          id="title"
          name="title"
          value="{{ old('title') || '' }}"
          placeholder="e.g. Invoice #1001"
          required
        />
        @if(flashMessages.has('errors.title'))
          <div class="error">{{ flashMessages.get('errors.title') }}</div>
        @end
      </div>

      <div class="form-group">
        <label for="customerName">Customer Name</label>
        <input
          type="text"
          id="customerName"
          name="customerName"
          value="{{ old('customerName') || '' }}"
          placeholder="e.g. Acme Corp"
          required
        />
        @if(flashMessages.has('errors.customerName'))
          <div class="error">{{ flashMessages.get('errors.customerName') }}</div>
        @end
      </div>

      <div class="form-group">
        <label for="issueDate">Issue Date</label>
        <input
          type="date"
          id="issueDate"
          name="issueDate"
          value="{{ old('issueDate') || '' }}"
          required
        />
        @if(flashMessages.has('errors.issueDate'))
          <div class="error">{{ flashMessages.get('errors.issueDate') }}</div>
        @end
      </div>

      <button type="submit">Create Document Draft</button>
    </form>

    <p style="margin-top: 2rem;">
      <a href="{{ route('documents.index') }}">← Back to Documents List</a>
    </p>
  </body>
</html>
