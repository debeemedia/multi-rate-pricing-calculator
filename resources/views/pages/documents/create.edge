@layout()
  <div class="form-page-container">
    <div class="form-card">
      <div class="form-header">
        <h1>Create New Document</h1>
        <p>Set up document metadata to begin adding line items, discounts, and custom tax rates.</p>
      </div>

      <form action="{{ route('documents.store') }}" method="POST">
        {{ csrfField() }}
        <div class="field-group">
          <label for="title">Document Title</label>
          <input
            type="text"
            id="title"
            name="title"
            value="{{ old('title') || '' }}"
            placeholder="e.g. Invoice #1001"
            data-invalid="{{ flashMessages.has('errors.title') ? 'true' : 'false' }}"
            required
          />
          @if(flashMessages.has('errors.title'))
            <div class="field-error">{{ flashMessages.get('errors.title') }}</div>
          @end
        </div>

        <div class="field-group">
          <label for="customerName">Customer Name</label>
          <input
            type="text"
            id="customerName"
            name="customerName"
            value="{{ old('customerName') || '' }}"
            placeholder="e.g. Acme Corp"
            data-invalid="{{ flashMessages.has('errors.customerName') ? 'true' : 'false' }}"
            required
          />
          @if(flashMessages.has('errors.customerName'))
            <div class="field-error">{{ flashMessages.get('errors.customerName') }}</div>
          @end
        </div>

        <div class="field-group">
          <label for="issueDate">Issue Date</label>
          <input
            type="date"
            id="issueDate"
            name="issueDate"
            value="{{ old('issueDate') || '' }}"
            data-invalid="{{ flashMessages.has('errors.issueDate') ? 'true' : 'false' }}"
            required
          />
          @if(flashMessages.has('errors.issueDate'))
            <div class="field-error">{{ flashMessages.get('errors.issueDate') }}</div>
          @end
        </div>

        <div class="form-actions">
          <button type="submit" class="button">Create Document Draft</button>
          <a href="{{ route('documents.index') }}" class="button secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
@end
