@layout()
  <div class="documents-container">
    <div class="page-header">
      <div>
        <h1>Documents</h1>
        <p class="subtitle">
          Manage draft and finalized documents, tracking totals with zero rounding errors.
        </p>
      </div>
      <div class="header-actions">
        <a href="{{ route('documents.summary_report') }}" class="button secondary">
          View Summary Report
        </a>
        <a href="{{ route('documents.create') }}" class="button">+ Create New Document</a>
      </div>
    </div>
    @if(!documents.length)
      <div class="empty-state">
        <p>No documents found.</p>
        <a href="{{ route('documents.create') }}" class="button">Create your first document</a>
      </div>
    @else
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Customer</th>
              <th>Status</th>
              <th class="text-right">Grand Total</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            @each(doc in documents)
              <tr>
                <td class="font-medium">{{ doc.title }}</td>
                <td>{{ doc.customerName }}</td>
                <td>
                  <span
                    class="badge {{ doc.status === 'finalized' ? 'badge-success' : 'badge-draft' }}"
                  >
                    {{ doc.status }}
                  </span>
                </td>
                <td class="text-right font-mono">${{ Number(doc.grandTotal).toFixed(2) }}</td>
                <td class="text-center">
                  <a href="{{ route('documents.show', { id: doc.id }) }}">View</a>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @end
  </div>
@end
