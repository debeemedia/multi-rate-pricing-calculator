<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Documents</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
      }
      th,
      td {
        border: 1px solid #e5e7eb;
        padding: 10px;
        text-align: left;
      }
      th {
        background: #f9fafb;
      }
      .btn {
        display: inline-block;
        background: #2563eb;
        color: white;
        padding: 8px 14px;
        text-decoration: none;
        border-radius: 4px;
      }
      .badge {
        padding: 2px 8px;
        border-radius: 9999px;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: bold;
      }
      .draft {
        background: #fef3c7;
        color: #92400e;
      }
      .finalized {
        background: #d1fae5;
        color: #065f46;
      }
    </style>
  </head>
  <body>
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
      <h1>Documents</h1>
      <a href="{{ route('documents.create') }}" class="btn">+ Create New Document</a>
    </div>
    @if(flashMessages.has('success'))
      <p style="color: green;">{{ flashMessages.get('success') }}</p>
    @end
    @if(!documents.length)
      <p>No documents found. Click create to start!</p>
    @else
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Customer</th>
            <th>Status</th>
            <th>Grand Total</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @each(doc in documents)
            <tr>
              <td>{{ doc.title }}</td>
              <td>{{ doc.customerName }}</td>
              <td><span class="badge {{ doc.status }}">{{ doc.status }}</span></td>
              <td>${{ (Number(doc.grandTotal) / 100).toFixed(2) }}</td>
              <td><a href="{{ route('documents.show', { id: doc.id }) }}">View</a></td>
            </tr>
          @end
        </tbody>
      </table>
    @end
  </body>
</html>
